FROM python:2.7.18-buster@sha256:d8fac68ebdc45b8d66d53f1ed6c1532da81109a8f5532a6ca0c951ed31107d70

WORKDIR /app

COPY kuiper/requirements_2.7.txt kuiper/requirements_3.txt /tmp/kuiper-build/
COPY docker/runtime/ /tmp/kuiper-build/
RUN sh /tmp/kuiper-build/install.sh

COPY ./system_health/ /system_health/

COPY ./system_health/crontabs/crontab.celery /etc/cron.d/crontab
RUN chmod 0644 /etc/cron.d/crontab
RUN crontab /etc/cron.d/crontab
RUN touch /var/log/cron_celery.log


CMD cron && exec python2 -m celery worker -A app.celery_app --loglevel=info -n "kuiper@%h"
